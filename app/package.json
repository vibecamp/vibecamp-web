{
    "name": "vibecamp-app",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome ci .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:migrate": "drizzle-kit migrate",
        "db:generate": "drizzle-kit generate",
        "db:pull": "drizzle-kit pull"
    },
    "dependencies": {
        "bcryptjs": "3.0.3",
        "dayjs": "1.11.23",
        "drizzle-orm": "0.45.2",
        "jose": "6.2.12",
        "next": "16.3.4",
        "pg": "8.23.0",
        "react": "19.2.8",
        "react-datepicker": "9.1.0",
        "react-dom": "19.2.8",
        "stripe": "22.6.1",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@types/node": "^24",
        "@types/pg": "8.23.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "drizzle-kit": "0.31.10",
        "sass": "1.104.0",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    }
}
